{
  "name": "Storefront",
  "tables": [
    {
      "name": "customers",
      "columns": [
        { "name": "id", "type": "uuid", "primaryKey": true },
        { "name": "email", "type": "text" },
        { "name": "full_name", "type": "text" },
        { "name": "created_at", "type": "timestamptz" }
      ]
    },
    {
      "name": "products",
      "columns": [
        { "name": "id", "type": "uuid", "primaryKey": true },
        { "name": "name", "type": "text" },
        { "name": "sku", "type": "varchar(32)" },
        { "name": "price_cents", "type": "integer" }
      ]
    },
    {
      "name": "orders",
      "columns": [
        { "name": "id", "type": "uuid", "primaryKey": true },
        { "name": "customer_id", "type": "uuid", "references": { "table": "customers", "column": "id" } },
        { "name": "status", "type": "text" },
        { "name": "placed_at", "type": "timestamptz" },
        { "name": "shipped_at", "type": "timestamptz", "nullable": true }
      ]
    },
    {
      "name": "order_items",
      "columns": [
        { "name": "id", "type": "uuid", "primaryKey": true },
        { "name": "order_id", "type": "uuid", "references": { "table": "orders", "column": "id" } },
        { "name": "product_id", "type": "uuid", "references": { "table": "products", "column": "id" } },
        { "name": "quantity", "type": "integer" },
        { "name": "unit_price_cents", "type": "integer" }
      ]
    }
  ]
}
